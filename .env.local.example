# Supabase (https://supabase.com) — create a project, copy these from
# Project Settings → API. The Service Role key lives server-side only.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Comment email notifications & Newsletter ESP (Resend - https://resend.com)
AUTHOR_EMAIL=author@example.com
RESEND_API_KEY=your-resend-api-key
RESEND_AUDIENCE_ID=your-resend-audience-id
COMMENTS_FROM_EMAIL="Zoha Asif Website <onboarding@resend.dev>"
NEWSLETTER_FROM_EMAIL="Zoha Asif <onboarding@resend.dev>"

# Admin login password (the "simple password login" for /admin)
ADMIN_PASSWORD=change-me
